<!DOCTYPE html>
<html>
    <meta charset="UTF-8">
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/css/style.css" rel="stylesheet"/>
    <title>Richard Rzeszutek :: Projects</title>
    <body class="dark:bg-gray-900 dark:text-gray-100">
        <div class="font-sans container mx-auto px-2 w-full sm:px-0 sm:w-10/12 lg:max-w-screen-md">
            <header class="mb-4 mt-6">
                <div class="flex items-end justify-between">
                    <h1 class="text-5xl sm:text-6xl font-header font-thin">
                        Richard Rzeszutek
                        <span class="text-xl text-gray-400">PhD</span>
                    </h1>

                    <button id="dark-toggle" class="relative inline-flex items-center h-6 mr-4" aria-label="Toggle dark mode">
                        <div class="w-11 h-6 bg-gray-200 rounded-full border border-gray-300"></div>
                        <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-200"></div>
                    </button>
                </div>
            </header>

            <script>
            (function(){
              var toggle=document.getElementById('dark-toggle'),track=toggle.querySelector('div'),dot=toggle.querySelector('div+div');
              function setDark(dark){
                document.documentElement.classList.toggle('dark',dark);
                dot.style.transform=dark?'translateX(20px)':'translateX(0)';
                track.classList.toggle('bg-gray-700',dark);
                track.classList.toggle('bg-gray-200',!dark);
                track.classList.toggle('border-gray-600',dark);
                track.classList.toggle('border-gray-300',!dark);
                dot.classList.toggle('bg-gray-200',dark);
                dot.classList.toggle('bg-white',!dark);
              }
              var stored=localStorage.getItem('darkMode');
              if(stored!==null){setDark(stored==='1');}
              else{setDark(window.matchMedia('(prefers-color-scheme:dark)').matches);}
              toggle.addEventListener('click',function(){
                var isDark=!document.documentElement.classList.contains('dark');
                setDark(isDark);
                localStorage.setItem('darkMode',isDark?'1':'0');
              });
              window.matchMedia('(prefers-color-scheme:dark)').addEventListener('change',function(e){
                if(localStorage.getItem('darkMode')===null){setDark(e.matches);}
              });
            })();
            </script>

            <section class="section">
                {% include "sections/projects.liquid" %}
            </section>

            <section class="section">
                {% include "sections/selected-publications.liquid" %}
            </section>

            <div class="mt-4 text-xs text-gray-600 dark:text-gray-400">
                &copy; {{ copyright.year }} Richard Rzeszutek
            </div>
        </div>
    </body>
</html>
